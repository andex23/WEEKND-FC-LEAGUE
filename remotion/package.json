{
  "name": "weekend-fc-ad",
  "version": "1.0.0",
  "private": true,
  "description": "15s vertical (9:16) promo trailer for Weekend FC — an online EA FC league. Built with Remotion.",
  "scripts": {
    "dev": "remotion studio",
    "studio": "remotion studio",
    "render": "remotion render WeekendFCAd out/weekend-fc-ad.mp4",
    "render:hq": "remotion render WeekendFCAd out/weekend-fc-ad.mp4 --crf=16 --color-space=bt709",
    "still": "remotion still WeekendFCAd out/poster.png --frame=420",
    "upgrade": "remotion upgrade",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fontsource/roboto": "^5.2.10",
    "@fontsource/roboto-mono": "^5.2.9",
    "@remotion/cli": "^4.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "remotion": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.6.0"
  }
}
